{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.SemanticKernel": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=agent_template.db"
  },
  "AI": {
    "Provider": "Ollama",
    "FastModel": {
      "ModelId": "llama3.2",
      "Endpoint": "http://localhost:11434/v1",
      "ApiKey": "unused"
    },
    "ReasoningModel": {
      "ModelId": "llama3.2",
      "Endpoint": "http://localhost:11434/v1",
      "ApiKey": "unused"
    },
    "MaxAllowedToolLoops": 5,
    "RequestTimeoutSeconds": 120
  }
}
